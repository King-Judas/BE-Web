@model BE_Web.Models.Order

@{
    ViewBag.Title = "Xóa đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Xóa đơn hàng</h2>

<h3>Bạn có chắc chắn muốn xóa đơn hàng này không?</h3>
<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>Mã đơn hàng</dt>
        <dd>@Html.DisplayFor(model => model.OrderID)</dd>

        <dt>Mã khách hàng</dt>
        <dd>@Html.DisplayFor(model => model.CustomerID)</dd>

        <dt>Ngày đặt hàng</dt>
        <dd>@Html.DisplayFor(model => model.OrderDate)</dd>

        <dt>Tổng tiền</dt>
        <dd>@Html.DisplayFor(model => model.TotalAmount)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-danger" /> |
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
</div>