@model BE_Web.Models.Product

@{
    ViewBag.Title = Model.ProductName;
}

<div class="row" style="margin-top: 30px;">
    <div class="col-md-5">
        @if (!string.IsNullOrEmpty(Model.ProductImage))
        {
            <img src="@Model.ProductImage" alt="@Model.ProductName" style="width: 100%; height: 350px; object-fit: cover; border-radius: 5px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);" />
        }
        else
        {
            <img src="https://via.placeholder.com/350" alt="No image" style="width: 100%; height: 350px; object-fit: cover;" />
        }
    </div>

    <div class="col-md-7">
        <h2>@Model.ProductName</h2>
        <hr />
        <p><strong>Danh mục:</strong> <span class="text-muted">@(Model.Category != null ? Model.Category.CategoryName : "Đang cập nhật")</span></p>

        <p style="font-size: 22px; color: #d9534f; font-weight: bold; margin: 15px 0;">
            Giá: @Model.ProductPrice.ToString("N0") VNĐ
        </p>

        <div style="margin: 20px 0;">
            <h4>Mô tả sản phẩm:</h4>
            <p style="line-height: 1.6;">@Model.ProductDecription</p>
        </div>

        <div style="margin-top: 30px;">
            <a href="@Url.Action("AddToCart", "Cart", new { id = Model.ProductID })" class="btn btn-success btn-lg">Thêm vào giỏ hàng</a>
            @Html.ActionLink("Quay lại trang chủ", "Index", null, new { @class = "btn btn-default btn-lg", style = "margin-left: 10px;" })
        </div>
    </div>
</div>